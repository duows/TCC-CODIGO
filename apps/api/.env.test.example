# Ambiente de teste de integração (apps/api/src/test/*.integration-spec.ts).
#
# Aponta para o MESMO Postgres do docker-compose.yml da raiz, mas para um banco
# de dados diferente ("hardware_csp_test"), descartável, nunca o "hardware_csp"
# de desenvolvimento. Antes de usar:
#
#   1) pnpm db:up
#   2) docker exec -it hardware-csp-postgres psql -U hardware_csp -c "CREATE DATABASE hardware_csp_test;"
#   3) cp apps/api/.env.test.example apps/api/.env.test
#   4) pnpm --filter @hardware-csp/api prisma:deploy:test
#
# Veja a seção "Testes de integração" do README na raiz do repositório.

DATABASE_URL="postgresql://hardware_csp:hardware_csp_dev@localhost:5432/hardware_csp_test?schema=public"
DIRECT_URL="postgresql://hardware_csp:hardware_csp_dev@localhost:5432/hardware_csp_test?schema=public"
